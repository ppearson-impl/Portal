# Kainos Project Portal — Environment Variables
# Copy this file to .env.local and fill in the values

# Feature flag — true = demo mode (mock data), false = live Workday
DEMO_MODE=true

# NextAuth
NEXTAUTH_SECRET=<generate: openssl rand -base64 32>
NEXTAUTH_URL=http://localhost:3000

# Demo credentials (used when DEMO_MODE=true)
DEMO_CLIENT_PASSWORD=demo-client-2026
DEMO_KAINOS_PASSWORD=demo-kainos-2026

# Workday OAuth2 — API client registered on your tenant
# The Redirect URI to register in Workday: {NEXTAUTH_URL}/api/workday-auth/callback
WORKDAY_CLIENT_ID=
WORKDAY_CLIENT_SECRET=

# Pre-fill the tenant URL field on the landing page (optional)
# Format: https://<workday-host>/<tenant-name>  e.g. https://wd2-impl-services1.workday.com/kainos_gms
NEXT_PUBLIC_WORKDAY_TENANT_URL=

# Used by the server-side Workday REST client (DEMO_MODE=false)
WORKDAY_TENANT=
WORKDAY_REFRESH_TOKEN=
WORKDAY_BASE_URL=
WORKDAY_TOKEN_URL=
