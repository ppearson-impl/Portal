# Kainos Project Portal — Environment Variables
# Copy this file to .env.local and fill in the values

# Feature flag — true = demo mode (mock data), false = live Workday GMS
DEMO_MODE=true

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Demo credentials (used when DEMO_MODE=true)
DEMO_CLIENT_PASSWORD=demo-client-2026
DEMO_KAINOS_PASSWORD=demo-kainos-2026

# Workday GMS tenant (used when DEMO_MODE=false)
WORKDAY_TENANT=gms
WORKDAY_CLIENT_ID=
WORKDAY_CLIENT_SECRET=
WORKDAY_REFRESH_TOKEN=
WORKDAY_BASE_URL=https://wd2-impl-services1.workday.com/ccx/api/v1/gms
WORKDAY_TOKEN_URL=https://wd2-impl-services1.workday.com/ccx/oauth2/gms/token
